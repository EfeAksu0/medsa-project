generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  passwordHash         String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  name                 String?
  tier                 SubscriptionTier @default(KNIGHT)
  avatarUrl            String?
  emailVerified        Boolean          @default(false)
  emailVerifiedAt      DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionEndsAt   DateTime?
  subscriptionStatus   String?
  lastActive           DateTime         @default(now())
  accounts             Account[]
  aiSessions           AiSession[]
  journalEntries       JournalEntry[]
  journalFolders       JournalFolder[]
  models               Model[]
  toDoItems            ToDoItem[]
  tradeFolders         TradeFolder[]
  trades               Trade[]

  @@map("users")
}

model Account {
  id             String    @id @default(uuid())
  userId         String
  name           String
  type           String
  currentBalance Decimal   @db.Decimal(12, 2)
  goalBalance    Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades         Trade[]

  @@map("accounts")
}

model Model {
  id        String    @id @default(uuid())
  userId    String
  name      String
  symbol    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]

  @@map("models")
}

model Session {
  id     String  @id @default(uuid())
  name   String  @unique
  trades Trade[]

  @@map("sessions")
}

model PsychologyTag {
  id     String            @id @default(uuid())
  name   String            @unique
  color  String            @default("#3b82f6")
  trades TradePsychology[]

  @@map("psychology_tags")
}

model MistakeTag {
  id     String         @id @default(uuid())
  name   String         @unique
  color  String         @default("#ef4444")
  trades TradeMistake[]

  @@map("mistake_tags")
}

model Trade {
  id         String            @id @default(uuid())
  userId     String
  instrument String
  entryPrice Decimal?          @db.Decimal(20, 8)
  exitPrice  Decimal?          @db.Decimal(20, 8)
  stopLoss   Decimal?          @db.Decimal(20, 8)
  takeProfit Decimal?          @db.Decimal(20, 8)
  quantity   Decimal?          @db.Decimal(20, 8)
  risk       Decimal?          @db.Decimal(12, 2)
  reward     Decimal?          @db.Decimal(10, 2)
  rrRatio    Decimal?          @db.Decimal(5, 2)
  result     TradeResult       @default(OPEN)
  notes      String?
  tradeDate  String
  strategy   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  accountId  String?
  modelId    String?
  sessionId  String?
  pnl        Decimal?          @db.Decimal(12, 2)
  exitDate   String?
  deletedAt  DateTime?
  direction  String            @default("LONG")
  folderId   String?
  imageUrl   String?
  mistakes   TradeMistake[]
  psychology TradePsychology[]
  account    Account?          @relation(fields: [accountId], references: [id])
  folder     TradeFolder?      @relation(fields: [folderId], references: [id])
  model      Model?            @relation(fields: [modelId], references: [id])
  session    Session?          @relation(fields: [sessionId], references: [id])
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model TradePsychology {
  id              String        @id @default(uuid())
  tradeId         String
  psychologyTagId String
  psychologyTag   PsychologyTag @relation(fields: [psychologyTagId], references: [id])
  trade           Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, psychologyTagId])
  @@map("trade_psychology")
}

model TradeMistake {
  id           String     @id @default(uuid())
  tradeId      String
  mistakeTagId String
  mistakeTag   MistakeTag @relation(fields: [mistakeTagId], references: [id])
  trade        Trade      @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, mistakeTagId])
  @@map("trade_mistakes")
}

model JournalEntry {
  id        String         @id @default(uuid())
  userId    String
  date      DateTime       @default(now())
  content   String
  tags      String[]
  mood      String?
  rating    Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  folderId  String?
  folder    JournalFolder? @relation(fields: [folderId], references: [id])
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

model JournalFolder {
  id        String         @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries   JournalEntry[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("journal_folders")
}

model TradeFolder {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]

  @@unique([userId, name])
  @@map("trade_folders")
}

model AiSession {
  id        String      @id @default(uuid())
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_sessions")
}

model AiMessage {
  id        String    @id @default(uuid())
  sessionId String
  role      String
  content   String
  emotion   String?
  createdAt DateTime  @default(now())
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model ToDoItem {
  id        String   @id @default(uuid())
  userId    String
  content   String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todo_items")
}

model UploadedImage {
  id        String   @id @default(uuid())
  userId    String
  data      Bytes
  mimeType  String
  filename  String?
  createdAt DateTime @default(now())

  @@map("uploaded_images")
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String?
  description String
  steps       String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  @@map("bug_reports")
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}

enum SubscriptionTier {
  KNIGHT
  MEDYSA_AI
}
